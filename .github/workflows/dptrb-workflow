name: DPTRB Demo

on:
  workflow_dispatch:

jobs:
  run-dptrb:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Prepare DPTRB project structure
        run: |
          mkdir -p services/routing
          mkdir -p services/ingestion
          mkdir -p db

          # Go routing engine
          cp Dockerfile services/routing/Dockerfile
          cp go.mod services/routing/go.mod
          cp *.go services/routing/

          # Python ingestion service
          cp ingestion_service.py services/ingestion/
          cp requirements.txt services/ingestion/

          cat > services/ingestion/Dockerfile <<'EOF'
          FROM python:3.12-slim

          RUN groupadd -r dptrb && useradd -r -g dptrb dptrb

          WORKDIR /app

          COPY requirements.txt .
          RUN pip install --no-cache-dir -r requirements.txt

          COPY ingestion_service.py .

          USER dptrb

          ENTRYPOINT ["python", "ingestion_service.py"]
          EOF

          # Database initialization
          cp init.sql db/

          echo "Prepared project structure:"
          find . -maxdepth 3 -type f | sort

      - name: Check Docker
        run: |
          docker --version
          docker compose version

      - name: Validate Docker Compose
        run: |
          docker compose config

      - name: Build and start DPTRB
        run: |
          docker compose up --build -d

      - name: Wait for services
        run: |
          sleep 45
          docker compose ps

      - name: Show routing engine logs
        run: |
          docker compose logs --no-color routing-engine || true

      - name: Show ingestion logs
        run: |
          docker compose logs --no-color ingestion-service || true

      - name: Show all service logs
        run: |
          docker compose logs --no-color --tail=200

      - name: Shutdown
        if: always()
        run: |
          docker compose down -v
